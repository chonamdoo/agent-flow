+import type { ReactNode } from 'react';
+
+type NavItem = { href: string; label: string };
+
+const navCache = new Map<string, NavItem[]>();
+
+export async function generateStaticParams() {
+  const response = await fetch('https://cms.example.com/nav');
+  navCache.set('marketing', await response.json());
+  return [{ segment: 'home' }, { segment: 'pricing' }];
+}
+
+export default async function MarketingLayout({ children }: { children: ReactNode }) {
+  const nav = navCache.get('marketing');
+  if (!nav) return null;
+
+  return (
+    <div className="shell">
+      <nav>
+        <ul>
+          {nav.map((item) => (
+            <li key={item.href}>
+              <a href={item.href}>{item.label}</a>
+            </li>
+          ))}
+        </ul>
+      </nav>
+      <main>{children}</main>
+      <footer>
+        <a href="/legal/terms">Terms</a>
+      </footer>
+    </div>
+  );
+}
