#!/bin/sh
# 빌드 전용. TLS를 가로채는 프록시 뒤에서 빌드할 때만 쓴다(secret `proxy_ca`).
# CA는 이 RUN 동안만 신뢰 저장소에 두고 끝나면 지운다. 이미지 layer에 남지 않는다.
set -e
secret=/run/secrets/proxy_ca
if [ -s "$secret" ]; then
  cp "$secret" /usr/local/share/ca-certificates/eval-env-build-proxy.crt
  update-ca-certificates >/dev/null
  export NODE_EXTRA_CA_CERTS="$secret" PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
         CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
fi
status=0
"$@" || status=$?
if [ -s "$secret" ]; then
  rm -f /usr/local/share/ca-certificates/eval-env-build-proxy.crt
  update-ca-certificates --fresh >/dev/null
fi
exit $status
