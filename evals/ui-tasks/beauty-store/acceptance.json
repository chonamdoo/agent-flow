    {"expectText": "listing-title", "equals": "Tools"},
    {"expectText": "empty-result", "contains": "Sorry, there is no item matching the applied filter."},
    {"expectCount": "product-card", "eq": 0},
    {"expectHidden": "load-more"}
   ]},
