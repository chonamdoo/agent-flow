{
 "task": "beauty-store",
 "version": 1,
 "observed": "2026-10-20",
 "stepTimeoutMs": 4000,
 "viewport": {"width": 1280, "height": 900},
 "checks": [
  {"id": "search-popular", "spec": "SPEC-1", "title": "Focusing the empty search shows the 10 popular terms and no recent list",
   "steps": [
    {"goto": "/"},
    {"focus": "search-input"},
    {"expectVisible": "search-layer"},
    {"expectCount": "popular-item", "eq": 10},
    {"expectText": {"testid": "popular-item", "nth": 0}, "contains": "toner"},
    {"expectText": {"testid": "popular-item", "nth": 9}, "contains": "shampoo"},
    {"expectHidden": "recent-searches"}
   ]},
  {"id": "search-debounce", "spec": "SPEC-1", "title": "Suggestions appear only after 200 ms idle and are capped per group",
   "steps": [
    {"goto": "/"},
    {"pause": true},
    {"focus": "search-input"},
    {"type": "search-input", "value": "ton"},
    {"tick": 150},
    {"expectCount": "suggest-keyword", "eq": 0},
    {"tick": 100},
    {"expectCount": "suggest-keyword", "min": 1, "max": 10},
    {"expectCount": "suggest-keyword", "eq": 10},
    {"expectCount": "suggest-category", "min": 1, "max": 2},
    {"expectVisible": {"testid": "suggest-category", "hasText": "Toners"}},
    {"expectCount": "suggest-brand", "eq": 0},
    {"fill": "search-input", "value": "BRAND"},
    {"tick": 250},
    {"expectCount": "suggest-brand", "eq": 2}
   ]},
  {"id": "search-submit", "spec": "SPEC-1", "title": "Enter trims the query, opens the results page and records a recent search once",
   "steps": [
    {"goto": "/"},
    {"fill": "search-input", "value": "  toner  "},
    {"press": "search-input", "key": "Enter"},
    {"expectUrl": true, "matches": "^/search\\?q=toner$"},
    {"expectText": "search-query", "contains": "toner"},
    {"fill": "search-input", "value": "toner"},
    {"press": "search-input", "key": "Enter"},
    {"expectUrl": true, "matches": "^/search\\?q=toner$"},
    {"fill": "search-input", "value": "serum"},
    {"press": "search-input", "key": "Enter"},
    {"expectUrl": true, "matches": "^/search\\?q=serum$"},
    {"reload": true},
    {"fill": "search-input", "value": ""},
    {"focus": "search-input"},
    {"expectVisible": "recent-searches"},
    {"expectCount": "recent-item", "eq": 2},
    {"expectText": {"testid": "recent-item", "nth": 0}, "contains": "serum"},
    {"expectText": {"testid": "recent-item", "nth": 1}, "contains": "toner"}
   ]},
  {"id": "search-blank-escape", "spec": "SPEC-1", "title": "A whitespace query does nothing and Escape closes the layer",
   "steps": [
    {"goto": "/"},
    {"focus": "search-input"},
    {"expectVisible": "search-layer"},
    {"press": "search-input", "key": "Escape"},
    {"expectHidden": "search-layer"},
    {"fill": "search-input", "value": "   "},
    {"press": "search-input", "key": "Enter"},
    {"expectUrl": true, "equals": "/"},
    {"reload": true},
    {"focus": "search-input"},
    {"expectHidden": "recent-searches"}
   ]},
  {"id": "hero-autoplay", "spec": "SPEC-2", "title": "The hero advances every 6 s and the toggle stops and restarts it",
   "steps": [
    {"pause": true},
    {"goto": "/"},
    {"expectText": "hero-counter", "equals": "1 / 4"},
    {"expectCount": "hero-slide", "eq": 1},
    {"tick": 5900},
    {"expectText": "hero-counter", "equals": "1 / 4"},
    {"tick": 100},
    {"expectText": "hero-counter", "equals": "2 / 4"},
    {"click": "hero-toggle"},
    {"tick": 12000},
    {"expectText": "hero-counter", "equals": "2 / 4"},
    {"click": "hero-toggle"},
    {"tick": 5900},
    {"expectText": "hero-counter", "equals": "2 / 4"},
    {"tick": 100},
    {"expectText": "hero-counter", "equals": "3 / 4"}
   ]},
  {"id": "hero-wrap", "spec": "SPEC-2", "title": "Prev from the first slide wraps to the last and next wraps back",
   "steps": [
    {"pause": true},
    {"goto": "/"},
    {"click": "hero-prev"},
    {"expectText": "hero-counter", "equals": "4 / 4"},
    {"click": "hero-next"},
    {"expectText": "hero-counter", "equals": "1 / 4"},
    {"click": "hero-next"},
    {"expectText": "hero-counter", "equals": "2 / 4"},
    {"expectCount": "hero-slide", "eq": 1}
   ]},
  {"id": "rail-ranks", "spec": "SPEC-3", "title": "The best-seller rail is ranked and its prev button starts disabled",
   "steps": [
    {"goto": "/"},
    {"expectCount": "rail", "min": 2},
    {"expectText": {"testid": "rank", "within": {"testid": "rail", "hasText": "Best Sellers"}, "nth": 0}, "equals": "1"},
    {"expectText": {"testid": "rank", "within": {"testid": "rail", "hasText": "Best Sellers"}, "nth": 1}, "equals": "2"},
    {"expectDisabled": {"testid": "rail-prev", "within": {"testid": "rail", "hasText": "Best Sellers"}}},
    {"click": {"testid": "rail-next", "within": {"testid": "rail", "hasText": "Best Sellers"}}},
    {"expectEnabled": {"testid": "rail-prev", "within": {"testid": "rail", "hasText": "Best Sellers"}}}
   ]},
  {"id": "card-prices", "spec": "SPEC-3", "title": "Cards show a range over options, a struck discount, or one price",
   "steps": [
    {"goto": "/category/111"},
    {"expectText": {"testid": "card-brand", "within": {"testid": "product-card", "hasText": "Product A Hydrating"}}, "equals": "Brand 1"},
    {"expectText": {"testid": "price-range", "within": {"testid": "product-card", "hasText": "Product A Hydrating"}}, "equals": "$16.00 - $27.20"},
    {"expectText": {"testid": "price-original", "within": {"testid": "product-card", "hasText": "Product C Daily"}}, "equals": "$30.00"},
    {"expectText": {"testid": "price-sale", "within": {"testid": "product-card", "hasText": "Product C Daily"}}, "contains": "$21.00"},
    {"expectText": {"testid": "price-sale", "within": {"testid": "product-card", "hasText": "Product B Calming"}}, "contains": "$18.00"},
    {"expectHidden": {"testid": "price-original", "within": {"testid": "product-card", "hasText": "Product B Calming"}}},
    {"expectHidden": {"testid": "price-range", "within": {"testid": "product-card", "hasText": "Product B Calming"}}}
   ]},
  {"id": "listing-load-more", "spec": "SPEC-4", "title": "A listing counts the subtree, defaults to Most Popular and pages by 24",
   "steps": [
    {"goto": "/category/100"},
    {"expectText": "listing-title", "equals": "Skincare"},
    {"expectText": "result-count", "matches": "\\b52 items\\b"},
    {"expectSelectedLabel": "sort-select", "equals": "Most Popular"},
    {"expectCount": "product-card", "eq": 24},
    {"expectText": "load-more", "contains": "MORE (1/3)"},
    {"click": "load-more"},
    {"expectCount": "product-card", "eq": 48},
    {"expectText": "load-more", "contains": "MORE (2/3)"},
    {"click": "load-more"},
    {"expectCount": "product-card", "eq": 52},
    {"expectHidden": "load-more"}
   ]},
  {"id": "listing-sort", "spec": "SPEC-4", "title": "Sorting by price orders the cards and returns to page 1",
   "steps": [
    {"goto": "/category/100"},
    {"click": "load-more"},
    {"expectCount": "product-card", "eq": 48},
    {"select": "sort-select", "label": "Price Low to High"},
    {"expectCount": "product-card", "eq": 24},
    {"expectSorted": "price-sale", "order": "asc"},
    {"expectText": "load-more", "contains": "MORE (1/3)"},
    {"select": "sort-select", "label": "Price High to Low"},
    {"expectSorted": "price-sale", "order": "desc"}
   ]},
  {"id": "listing-filter", "spec": "SPEC-4", "title": "A sub-category filter narrows the count, adds a chip and keeps the sort",
   "steps": [
    {"goto": "/category/100"},
    {"select": "sort-select", "label": "Price Low to High"},
    {"check": "filter-111"},
    {"expectText": "result-count", "matches": "\\b14 items\\b"},
    {"expectCount": "refine-chip", "eq": 1},
    {"expectText": "refine-chip", "contains": "Mists"},
    {"expectSelectedLabel": "sort-select", "equals": "Price Low to High"},
    {"expectCount": "product-card", "eq": 14},
    {"expectHidden": "load-more"},
    {"check": "filter-112"},
    {"expectText": "result-count", "matches": "\\b24 items\\b"},
    {"expectCount": "refine-chip", "eq": 2},
    {"click": "clear-all"},
    {"expectText": "result-count", "matches": "\\b52 items\\b"},
    {"expectCount": "refine-chip", "eq": 0},
    {"check": "filter-130"},
    {"expectText": "result-count", "matches": "\\b16 items\\b"},
    {"click": "refine-chip"},
    {"expectText": "result-count", "matches": "\\b52 items\\b"}
   ]},
  {"id": "listing-page-size-empty", "spec": "SPEC-4", "title": "Page size recomputes the pages and an empty category says so",
   "steps": [
    {"goto": "/category/100"},
    {"select": "page-size", "label": "48"},
    {"expectCount": "product-card", "eq": 48},
    {"expectText": "load-more", "contains": "MORE (1/2)"},
